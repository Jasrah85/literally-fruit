{
  "name": "literally-fruit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run images",
    "dev": "next dev",
    "prebuild": "npm run validate && npm run images",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-catalog.ts",
    "schema": "tsx scripts/generate-catalog-schema.ts",
    "images": "tsx scripts/build-images.ts",
    "check": "npm run validate && npm run images && npm run lint && npm run typecheck",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.5",
    "@opennextjs/cloudflare": "^1.20.3",
    "next": "16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.7.4",
    "wrangler": "^4.156.2"
  }
}
